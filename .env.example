# URLs dos servidores MCP
ORGANIZZE_MCP_URL=https://mcp.organizze.com.br/mcp
VISOR_MCP_URL=https://mcp.visorfinance.app

# Onde persistir tokens e o state.db (default: ~/.visorsync)
VISORSYNC_HOME=~/.visorsync

# Porta local usada pelo redirect do fluxo OAuth2 (loopback, RFC 8252)
OAUTH_CALLBACK_PORT=53682

# Client IDs, se o registro dinâmico (RFC 7591) não for suportado pelo servidor.
# Deixe em branco para tentar registro dinâmico automaticamente.
ORGANIZZE_OAUTH_CLIENT_ID=
VISOR_OAUTH_CLIENT_ID=
